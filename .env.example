# Copy this file to .env and adjust values per environment.
# Never commit the real .env file.

# Which environment config to load: dev | staging
TEST_ENV=dev

# Base URL of the OrangeHRM instance under test
BASE_URL=https://opensource-demo.orangehrmlive.com

# Seed admin credentials for the public OrangeHRM demo instance
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123
